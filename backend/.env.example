# Copy this file to .env and fill in real values before starting the server.

# MongoDB Atlas (or any MongoDB) connection string.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/?appName=<app-name>

# Any long random string — used to sign JWT auth tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Port the server listens on.
PORT=5000

# The frontend's public URL, used for CORS. Comma-separate multiple origins
# (e.g. an HTTP and HTTPS hostname during a domain migration).
FRONTEND_ORIGIN=http://localhost:5173

# Optional: if you terminate HTTPS in this app (see backend/ssl/), the port
# to listen on for it. Only takes effect when backend/ssl/privkey.pem and
# backend/ssl/fullchain.pem both exist.
HTTPS_PORT=443

# Note: SMTP/IMAP email credentials and the WhatsApp connection are NOT set
# here — they're configured per-deployment from inside the app itself
# (Settings > Email Inbox, and Settings > WhatsApp), since each company
# using this CRM connects its own mailbox and WhatsApp number.
